<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0"
            prefWidth="950.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="view.CartViewController"
            style="-fx-background-color: linear-gradient(to bottom right, #141E30, #243B55);">

    <children>

        <StackPane
                AnchorPane.topAnchor="0.0"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0">

            <ScrollPane
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background: transparent;
                           -fx-background-color: transparent;">

                <content>

                    <VBox
                            alignment="CENTER"
                            maxWidth="600.0"
                            spacing="18.0">

                        <padding>
                            <Insets
                                    top="30.0"
                                    right="30.0"
                                    bottom="30.0"
                                    left="30.0"/>
                        </padding>

                        <Label
                                text="Shopping Cart"
                                textFill="WHITE">

                            <font>
                                <Font
                                        name="System Bold"
                                        size="32.0"/>
                            </font>

                        </Label>


                        <Label
                                fx:id="creditLabel"
                                text="Your Credit: 0"
                                textFill="#B8C6D9">

                            <font>
                                <Font
                                        name="System"
                                        size="16.0"/>
                            </font>

                        </Label>


                        <VBox
                                fx:id="cartItemsBox"
                                maxWidth="500.0"
                                spacing="8.0"
                                style="-fx-background-color: rgba(255,255,255,0.08);
                                       -fx-background-radius: 15px;
                                       -fx-padding: 20px;
                                       -fx-border-color: rgba(255,255,255,0.15);
                                       -fx-border-radius: 15px;"/>


                        <HBox
                                alignment="CENTER"
                                maxWidth="500.0">

                            <Label
                                    fx:id="totalLabel"
                                    text="Total: 0.00"
                                    textFill="WHITE">

                                <font>
                                    <Font
                                            name="System Bold"
                                            size="20.0"/>
                                </font>

                            </Label>

                        </HBox>


                        <Button
                                fx:id="checkoutButton"
                                mnemonicParsing="false"
                                onAction="#checkout"
                                prefHeight="48.0"
                                prefWidth="500.0"
                                text="Checkout"
                                style="-fx-background-color: #FFFFFF;
                                       -fx-text-fill: #243B55;
                                       -fx-font-size: 16px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 10px;
                                       -fx-cursor: hand;"/>


                        <Button
                                mnemonicParsing="false"
                                onAction="#back"
                                prefHeight="45.0"
                                prefWidth="500.0"
                                text="Back"
                                style="-fx-background-color: transparent;
                                       -fx-text-fill: #B8C6D9;
                                       -fx-border-color: #B8C6D9;
                                       -fx-border-radius: 10px;
                                       -fx-background-radius: 10px;
                                       -fx-cursor: hand;"/>

                    </VBox>

                </content>

            </ScrollPane>

        </StackPane>

    </children>

</AnchorPane>