<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane style="-fx-background-color: #243B55;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.ProductDetailsViewController">

    <children>

        <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent;                            -fx-background-color: transparent;">

                <content>

                    <VBox alignment="CENTER" maxWidth="500.0" spacing="3.0">

                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>

                        <Label text="Product Details" textFill="WHITE">

                            <font>
                                <Font name="System Bold" size="32.0" />
                            </font>

                        </Label>

                        <Label fx:id="nameLabel" text="Product Name" textFill="#B8C6D9">

                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>

                        </Label>

                        <VBox alignment="CENTER" maxWidth="420.0" prefHeight="194.0" prefWidth="420.0" spacing="7.0" style="-fx-background-color: rgba(255,255,255,0.10);                                        -fx-background-radius: 15px;                                        -fx-border-color: rgba(255,255,255,0.20);                                        -fx-border-radius: 15px;                                        -fx-border-width: 1px;                                        -fx-padding: 18px;">

                            <HBox alignment="CENTER_LEFT" spacing="10.0">

                                <Label style="-fx-font-weight: bold;" text="Price:" textFill="#B8C6D9" />

                                <Label fx:id="priceLabel" text="0.0" textFill="WHITE" />

                            </HBox>


                            <HBox alignment="CENTER_LEFT" spacing="10.0">

                                <Label style="-fx-font-weight: bold;" text="Status:" textFill="#B8C6D9" />

                                <Label fx:id="statusLabel" text="Available" textFill="WHITE" />

                            </HBox>


                            <HBox alignment="CENTER_LEFT" spacing="10.0">

                                <Label style="-fx-font-weight: bold;" text="Inventory:" textFill="#B8C6D9" />

                                <Label fx:id="inventoryLabel" text="0" textFill="WHITE" />

                            </HBox>


                            <HBox alignment="CENTER_LEFT" spacing="10.0">

                                <Label style="-fx-font-weight: bold;" text="Category:" textFill="#B8C6D9" />

                                <Label fx:id="categoryLabel" text="Category" textFill="WHITE" />

                            </HBox>


                            <HBox alignment="CENTER_LEFT" spacing="10.0">

                                <Label style="-fx-font-weight: bold;" text="Rating:" textFill="#B8C6D9" />

                                <Label fx:id="ratingLabel" text="0.0" textFill="WHITE" />

                            </HBox>


                            <Label style="-fx-font-weight: bold;" text="Additional Information" textFill="#B8C6D9" />

                            <Label fx:id="detailsLabel" text="Details" textFill="WHITE" wrapText="true" />

                        </VBox>

                        <HBox alignment="CENTER" spacing="10.0">

                            <Label style="-fx-font-weight: bold;" text="Quantity:" textFill="#B8C6D9" />

                            <TextField fx:id="quantityField" prefHeight="42.0" prefWidth="120.0" promptText="Quantity" style="-fx-background-color: rgba(255,255,255,0.12);                                            -fx-text-fill: #FFFFFF;                                            -fx-prompt-text-fill: #AAB7C8;                                            -fx-font-size: 14px;                                            -fx-background-radius: 10px;                                            -fx-border-color: rgba(255,255,255,0.25);                                            -fx-border-radius: 10px;                                            -fx-border-width: 1px;" />

                        </HBox>

                        <Button fx:id="addToCartButton" mnemonicParsing="false" onAction="#addToCart" prefHeight="45.0" prefWidth="420.0" style="-fx-background-color: #FFFFFF;                                        -fx-text-fill: #243B55;                                        -fx-font-size: 15px;                                        -fx-font-weight: bold;                                        -fx-background-radius: 10px;                                        -fx-cursor: hand;" text="Add to Cart" />

                        <Button fx:id="viewCartButton" mnemonicParsing="false" onAction="#viewCart" prefHeight="45.0" prefWidth="420.0" style="-fx-background-color: rgba(255,255,255,0.10);                                        -fx-text-fill: WHITE;                                        -fx-font-size: 15px;                                        -fx-font-weight: bold;                                        -fx-background-radius: 10px;                                        -fx-border-color: rgba(255,255,255,0.30);                                        -fx-border-radius: 10px;                                        -fx-cursor: hand;" text="View Cart" />


                        <HBox alignment="CENTER" spacing="10.0">

                            <TextField fx:id="ratingField" prefHeight="42.0" prefWidth="280.0" promptText="Enter rating (0 - 5)" style="-fx-background-color: rgba(255,255,255,0.12);                                            -fx-text-fill: #FFFFFF;                                            -fx-prompt-text-fill: #AAB7C8;                                            -fx-background-radius: 10px;                                            -fx-border-color: rgba(255,255,255,0.25);                                            -fx-border-radius: 10px;" />

                            <Button fx:id="rateButton" mnemonicParsing="false" onAction="#rateProduct" prefHeight="42.0" prefWidth="120.0" style="-fx-background-color: #FFFFFF;                                            -fx-text-fill: #243B55;                                            -fx-font-weight: bold;                                            -fx-background-radius: 10px;                                            -fx-cursor: hand;" text="Rate" />

                        </HBox>

                        <TextArea fx:id="commentArea" prefHeight="38.0" prefWidth="420.0" promptText="Write your comment..." style="-fx-background-color: rgba(255,255,255,0.12); -fx-text-fill: #243B55; -fx-prompt-text-fill: #AAB7C8; -fx-background-radius: 10px; -fx-border-color: rgba(255,255,255,0.25); -fx-border-radius: 10px;" wrapText="true" />


                        <Button fx:id="commentButton" mnemonicParsing="false" onAction="#addComment" prefHeight="45.0" prefWidth="420.0" style="-fx-background-color: #FFFFFF;                                        -fx-text-fill: #243B55;                                        -fx-font-size: 15px;                                        -fx-font-weight: bold;                                        -fx-background-radius: 10px;                                        -fx-cursor: hand;" text="Add Comment" />

                        <VBox maxWidth="420.0" spacing="12.0" style="-fx-background-color: rgba(255,255,255,0.08);                                        -fx-background-radius: 15px;                                        -fx-border-color: rgba(255,255,255,0.15);                                        -fx-border-radius: 15px;                                        -fx-border-width: 1px;                                        -fx-padding: 18px;">

                            <Label text="Customer Comments" textFill="WHITE">

                                <font>
                                    <Font name="System Bold" size="18.0" />
                                </font>

                            </Label>


                            <VBox fx:id="commentsContainer" maxWidth="400.0" spacing="10.0" />

                        </VBox>

                        <Button mnemonicParsing="false" onAction="#back" prefHeight="45.0" prefWidth="420.0" style="-fx-background-color: transparent;                                        -fx-text-fill: #B8C6D9;                                        -fx-border-color: #B8C6D9;                                        -fx-border-radius: 10px;                                        -fx-background-radius: 10px;                                        -fx-cursor: hand;" text="Back" />

                    </VBox>

                </content>

            </ScrollPane>

        </StackPane>

    </children>

</AnchorPane>
