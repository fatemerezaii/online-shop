<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0"
            prefWidth="950.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="view.HistoryController"
            style="-fx-background-color: linear-gradient(to bottom right, #141E30, #243B55);">

    <children>

        <StackPane AnchorPane.topAnchor="0.0"
                   AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0">

            <VBox spacing="18.0"
                  maxWidth="850.0"
                  maxHeight="550.0">

                <VBox spacing="5.0">

                    <Label text="Purchase History"
                           textFill="WHITE">
                        <font>
                            <Font name="System Bold" size="30.0"/>
                        </font>
                    </Label>

                    <Label text="View your invoices and purchased products"
                           textFill="#B8C6D9">
                        <font>
                            <Font name="System" size="14.0"/>
                        </font>
                    </Label>

                </VBox>

                <HBox spacing="35.0">

                    <VBox spacing="3.0">
                        <Label text="Invoice ID"
                               textFill="#8FA3BA"/>
                        <Label fx:id="factorIdLabel"
                               text="-"
                               textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="15.0"/>
                            </font>
                        </Label>
                    </VBox>

                    <VBox spacing="3.0">
                        <Label text="Date"
                               textFill="#8FA3BA"/>
                        <Label fx:id="dateLabel"
                               text="-"
                               textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="15.0"/>
                            </font>
                        </Label>
                    </VBox>

                    <VBox spacing="3.0">
                        <Label text="Paid Price"
                               textFill="#8FA3BA"/>
                        <Label fx:id="paidPriceLabel"
                               text="-"
                               textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="15.0"/>
                            </font>
                        </Label>
                    </VBox>

                </HBox>

                <HBox spacing="20.0"
                      VBox.vgrow="ALWAYS">

                    <VBox spacing="10.0"
                          prefWidth="230.0">

                        <Label text="Invoices"
                               textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="17.0"/>
                            </font>
                        </Label>

                        <ListView fx:id="invoiceListView"
                                  prefWidth="230.0"
                                  VBox.vgrow="ALWAYS"
                                  style="-fx-background-color: rgba(255,255,255,0.08);
                                         -fx-control-inner-background: rgba(255,255,255,0.08);
                                         -fx-background-radius: 10px;
                                         -fx-border-color: rgba(255,255,255,0.2);
                                         -fx-border-radius: 10px;"/>

                    </VBox>

                    <VBox spacing="10.0"
                          HBox.hgrow="ALWAYS">

                        <Label text="Purchased Products"
                               textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="17.0"/>
                            </font>
                        </Label>

                        <TableView fx:id="productTable"
                                   VBox.vgrow="ALWAYS"
                                   style="-fx-background-color: rgba(255,255,255,0.08);
                                          -fx-control-inner-background: rgba(255,255,255,0.08);
                                          -fx-background-radius: 10px;
                                          -fx-border-color: rgba(255,255,255,0.2);
                                          -fx-border-radius: 10px;">

                            <columns>

                                <TableColumn fx:id="idColumn"
                                             text="ID"
                                             prefWidth="55.0"/>

                                <TableColumn fx:id="nameColumn"
                                             text="Product"
                                             prefWidth="150.0"/>

                                <TableColumn fx:id="categoryColumn"
                                             text="Category"
                                             prefWidth="110.0"/>

                                <TableColumn fx:id="priceColumn"
                                             text="Price"
                                             prefWidth="90.0"/>

                                <TableColumn fx:id="quantityColumn"
                                             text="Quantity"
                                             prefWidth="80.0"/>

                                <TableColumn fx:id="statusColumn"
                                             text="Status"
                                             prefWidth="90.0"/>

                            </columns>

                        </TableView>

                    </VBox>

                </HBox>

                <Button fx:id="backButton"
                        text="Back"
                        mnemonicParsing="false"
                        onAction="#back"
                        prefWidth="100.0"
                        prefHeight="40.0"
                        style="-fx-background-color: rgba(255,255,255,0.12);
                               -fx-text-fill: WHITE;
                               -fx-font-size: 14px;
                               -fx-background-radius: 10px;
                               -fx-border-color: rgba(255,255,255,0.25);
                               -fx-border-radius: 10px;
                               -fx-cursor: hand;"/>

            </VBox>

        </StackPane>

    </children>

</AnchorPane>