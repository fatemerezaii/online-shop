<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: linear-gradient(to bottom right, #141E30, #243B55);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.AdminMenuController">

    <children>

        <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <VBox alignment="CENTER" maxWidth="500.0" spacing="18.0">

                <Label text="Admin Menu" textFill="WHITE">

                    <font>
                        <Font name="System Bold" size="32.0" />
                    </font>

                </Label>


                <Label text="Enter an admin command" textFill="#B8C6D9">

                    <font>
                        <Font name="System" size="15.0" />
                    </font>

                </Label>

                <TextField fx:id="commandField" onAction="#executeCommand" prefHeight="48.0" prefWidth="500.0" promptText="Enter command..." style="-fx-background-color: rgba(255,255,255,0.12);                                   -fx-text-fill: #FFFFFF;                                   -fx-prompt-text-fill: #AAB7C8;                                   -fx-font-size: 14px;                                   -fx-background-radius: 10px;                                   -fx-border-color: rgba(255,255,255,0.25);                                   -fx-border-radius: 10px;                                   -fx-border-width: 1px;" />

                <Button fx:id="executeButton" mnemonicParsing="false" onAction="#executeCommand" prefHeight="48.0" prefWidth="500.0" style="-fx-background-color: #FFFFFF;                                -fx-text-fill: #243B55;                                -fx-font-size: 16px;                                -fx-font-weight: bold;                                -fx-background-radius: 10px;                                -fx-cursor: hand;" text="Execute" />

                <TextArea fx:id="outputArea" editable="false" focusTraversable="false" prefHeight="150.0" prefWidth="500.0" promptText="Command result..." style="-fx-control-inner-background: rgba(255,255,255,0.10); -fx-text-fill: #243B55; -fx-prompt-text-fill: #AAB7C8; -fx-font-size: 14px; -fx-background-radius: 10px; -fx-border-color: rgba(255,255,255,0.20); -fx-border-radius: 10px;" wrapText="true" />

                <Button mnemonicParsing="false" onAction="#logout" prefHeight="42.0" prefWidth="180.0" style="-fx-background-color: transparent;                                -fx-text-fill: #B8C6D9;                                -fx-font-size: 14px;                                -fx-cursor: hand;" text="Logout" />

            </VBox>

        </StackPane>

    </children>

</AnchorPane>
