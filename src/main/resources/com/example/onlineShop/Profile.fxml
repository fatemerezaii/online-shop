<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" style="-fx-background-color: linear-gradient(to bottom right, #141E30, #243B55);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.ProfileController">

    <children>

        <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <VBox alignment="CENTER" maxWidth="400.0" spacing="20.0">

                <!-- Title -->

                <Label text="Profile" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="32.0" />
                    </font>
                </Label>

                <Label text="Your account information" textFill="#B8C6D9">
                    <font>
                        <Font name="System" size="15.0" />
                    </font>
                </Label>


                <!-- Profile Information -->

                <VBox maxWidth="360.0" spacing="10.0">

                    <!-- Username -->

                    <HBox alignment="CENTER_LEFT" prefHeight="48.0" spacing="15.0" style="-fx-background-color: rgba(255,255,255,0.10);                                  -fx-background-radius: 10px;                                  -fx-border-color: rgba(255,255,255,0.20);                                  -fx-border-radius: 10px;                                  -fx-padding: 0 15 0 15;">

                        <Label prefWidth="110.0" text="Username" textFill="#B8C6D9">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>

                        <Label fx:id="usernameText" text="username" textFill="WHITE">
                            <font>
                                <Font name="System" size="15.0" />
                            </font>
                        </Label>

                    </HBox>


                    <!-- Email -->

                    <HBox alignment="CENTER_LEFT" prefHeight="48.0" spacing="15.0" style="-fx-background-color: rgba(255,255,255,0.10);                                  -fx-background-radius: 10px;                                  -fx-border-color: rgba(255,255,255,0.20);                                  -fx-border-radius: 10px;                                  -fx-padding: 0 15 0 15;">

                        <Label prefWidth="110.0" text="Email" textFill="#B8C6D9">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>

                        <Label fx:id="emailText" text="email" textFill="WHITE">
                            <font>
                                <Font name="System" size="15.0" />
                            </font>
                        </Label>

                    </HBox>


                    <!-- Phone Number -->

                    <HBox alignment="CENTER_LEFT" prefHeight="48.0" spacing="15.0" style="-fx-background-color: rgba(255,255,255,0.10);                                  -fx-background-radius: 10px;                                  -fx-border-color: rgba(255,255,255,0.20);                                  -fx-border-radius: 10px;                                  -fx-padding: 0 15 0 15;">

                        <Label prefWidth="110.0" text="Phone Number" textFill="#B8C6D9">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>

                        <Label fx:id="phoneNumberText" text="phoneNumber" textFill="WHITE">
                            <font>
                                <Font name="System" size="15.0" />
                            </font>
                        </Label>

                    </HBox>

                </VBox>


                <!-- Buttons -->

                <HBox alignment="CENTER" spacing="15.0">

                    <Button fx:id="editBtn" mnemonicParsing="false" onAction="#edit" prefHeight="45.0" prefWidth="170.0" style="-fx-background-color: #FFFFFF;                                    -fx-text-fill: #243B55;                                    -fx-font-size: 15px;                                    -fx-font-weight: bold;                                    -fx-background-radius: 10px;                                    -fx-cursor: hand;" text="Edit Profile" />

                    <Button fx:id="backBtn" mnemonicParsing="false" onAction="#back" prefHeight="45.0" prefWidth="100.0" style="-fx-background-color: rgba(255,255,255,0.12);                                    -fx-text-fill: WHITE;                                    -fx-font-size: 14px;                                    -fx-background-radius: 10px;                                    -fx-border-color: rgba(255,255,255,0.25);                                    -fx-border-radius: 10px;                                    -fx-cursor: hand;" text="Back" />

                </HBox>

                <Label text="Manage your account information" textFill="#8FA3BA">
                    <font>
                        <Font name="System" size="13.0" />
                    </font>
                </Label>

            </VBox>

        </StackPane>

    </children>

</AnchorPane>
