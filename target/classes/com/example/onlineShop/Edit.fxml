<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.control.PasswordField?>
        <?import javafx.scene.control.TextField?>
        <?import javafx.scene.layout.AnchorPane?>
        <?import javafx.scene.layout.VBox?>
        <?import javafx.scene.layout.StackPane?>
        <?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0"
            prefWidth="600.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="view.EditController"
            style="-fx-background-color: linear-gradient(to bottom right, #141E30, #243B55);">

    <children>

        <StackPane AnchorPane.topAnchor="0.0"
                   AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0">

            <VBox alignment="CENTER"
                  spacing="20.0"
                  maxWidth="360.0">

                <Label text="Edit Profile"
                       textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="32.0"/>
                    </font>
                </Label>

                <Label text="Update your account information"
                       textFill="#B8C6D9">
                    <font>
                        <Font name="System" size="15.0"/>
                    </font>
                </Label>

                <VBox alignment="CENTER"
                      spacing="12.0"
                      maxWidth="300.0">

                    <TextField fx:id="usernameField"
                               promptText="Username"
                               prefWidth="300.0"
                               prefHeight="45.0"
                               style="-fx-background-color: rgba(255,255,255,0.12);
                                      -fx-text-fill: #FFFFFF;
                                      -fx-prompt-text-fill: #AAB7C8;
                                      -fx-font-size: 14px;
                                      -fx-background-radius: 10px;
                                      -fx-border-color: rgba(255,255,255,0.25);
                                      -fx-border-radius: 10px;
                                      -fx-border-width: 1px;"/>

                    <TextField fx:id="emailField"
                               promptText="Email"
                               prefWidth="300.0"
                               prefHeight="45.0"
                               style="-fx-background-color: rgba(255,255,255,0.12);
                                      -fx-text-fill: #FFFFFF;
                                      -fx-prompt-text-fill: #AAB7C8;
                                      -fx-font-size: 14px;
                                      -fx-background-radius: 10px;
                                      -fx-border-color: rgba(255,255,255,0.25);
                                      -fx-border-radius: 10px;
                                      -fx-border-width: 1px;"/>

                    <TextField fx:id="phoneNumberField"
                               promptText="Phone Number"
                               prefWidth="300.0"
                               prefHeight="45.0"
                               style="-fx-background-color: rgba(255,255,255,0.12);
                                      -fx-text-fill: #FFFFFF;
                                      -fx-prompt-text-fill: #AAB7C8;
                                      -fx-font-size: 14px;
                                      -fx-background-radius: 10px;
                                      -fx-border-color: rgba(255,255,255,0.25);
                                      -fx-border-radius: 10px;
                                      -fx-border-width: 1px;"/>

                    <PasswordField fx:id="passwordField"
                                   promptText="New Password"
                                   prefWidth="300.0"
                                   prefHeight="45.0"
                                   style="-fx-background-color: rgba(255,255,255,0.12);
                                          -fx-text-fill: #FFFFFF;
                                          -fx-prompt-text-fill: #AAB7C8;
                                          -fx-font-size: 14px;
                                          -fx-background-radius: 10px;
                                          -fx-border-color: rgba(255,255,255,0.25);
                                          -fx-border-radius: 10px;
                                          -fx-border-width: 1px;"/>

                    <Button fx:id="editButton"
                            mnemonicParsing="false"
                            onAction="#edit"
                            text="Save Changes"
                            prefWidth="300.0"
                            prefHeight="48.0"
                            style="-fx-background-color: #FFFFFF;
                                   -fx-text-fill: #243B55;
                                   -fx-font-size: 16px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 10px;
                                   -fx-cursor: hand;"/>

                </VBox>

                <Label text="Keep your account information up to date"
                       textFill="#8FA3BA">
                    <font>
                        <Font name="System" size="13.0"/>
                    </font>
                </Label>

            </VBox>

        </StackPane>

    </children>

</AnchorPane>
