<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane style="-fx-background-color: #243B55;" xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.AdminMenuController">

    <children>

        <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                   AnchorPane.topAnchor="0.0">

            <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER"
                        style="-fx-background: transparent;                            -fx-background-color: transparent;">

                <content>

                    <VBox alignment="CENTER" maxWidth="600.0" spacing="3.0">

                        <padding>
                            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
                        </padding>

                        <Label text="Admin Menu" textFill="WHITE">

                            <font>
                                <Font name="System Bold" size="32.0"/>
                            </font>

                        </Label>


                        <Label graphicTextGap="1.0" text="Manage your online shop" textFill="#B8C6D9">

                            <font>
                                <Font name="System" size="15.0"/>
                            </font>

                        </Label>

                        <VBox maxWidth="500.0" prefHeight="222.0" prefWidth="500.0" spacing="12.0"
                              style="-fx-background-color: rgba(255,255,255,0.08);                                        -fx-background-radius: 15px;                                        -fx-padding: 20px;                                        -fx-border-color: rgba(255,255,255,0.15);                                        -fx-border-radius: 15px;">

                            <Label text="Admin Commands" textFill="WHITE">

                                <font>
                                    <Font name="System Bold" size="18.0"/>
                                </font>

                            </Label>


                            <TextField fx:id="commandField" onAction="#executeCommand" prefHeight="48.0"
                                       promptText="Enter command..."
                                       style="-fx-background-color: rgba(255,255,255,0.12);                                            -fx-text-fill: #FFFFFF;                                            -fx-prompt-text-fill: #AAB7C8;                                            -fx-font-size: 14px;                                            -fx-background-radius: 10px;                                            -fx-border-color: rgba(255,255,255,0.25);                                            -fx-border-radius: 10px;"/>


                            <Button maxWidth="Infinity" onAction="#executeCommand" prefHeight="45.0"
                                    style="-fx-background-color: #FFFFFF;                                            -fx-text-fill: #243B55;                                            -fx-font-size: 15px;                                            -fx-font-weight: bold;                                            -fx-background-radius: 10px;                                            -fx-cursor: hand;"
                                    text="Execute Command"/>


                            <TextArea fx:id="outputArea" editable="false" focusTraversable="false" prefHeight="72.0"
                                      prefWidth="458.0" promptText="Command result..."
                                      style="-fx-control-inner-background: rgba(255,255,255,0.10);                                            -fx-text-fill: #243B55;                                            -fx-prompt-text-fill: #AAB7C8;                                            -fx-background-radius: 10px;                                            -fx-border-color: rgba(255,255,255,0.20);                                            -fx-border-radius: 10px;"
                                      wrapText="true"/>

                        </VBox>

                        <VBox maxWidth="500.0" spacing="12.0"
                              style="-fx-background-color: rgba(255,255,255,0.08);                                        -fx-background-radius: 15px;                                        -fx-padding: 20px;                                        -fx-border-color: rgba(255,255,255,0.15);                                        -fx-border-radius: 15px;">

                            <Label text="Product Management" textFill="WHITE">

                                <font>
                                    <Font name="System Bold" size="18.0"/>
                                </font>

                            </Label>

                            <TextField fx:id="productIdField" prefHeight="35.0" prefWidth="458.0"
                                       promptText="Product ID"
                                       style="-fx-background-color: rgba(255,255,255,0.12);                                            -fx-text-fill: #FFFFFF;                                            -fx-prompt-text-fill: #AAB7C8;                                            -fx-background-radius: 10px;                                            -fx-border-color: rgba(255,255,255,0.25);                                            -fx-border-radius: 10px;"/>

                            <Button maxWidth="Infinity" onAction="#loadProduct" prefHeight="42.0"
                                    style="-fx-background-color: #FFFFFF;                                            -fx-text-fill: #243B55;                                            -fx-font-weight: bold;                                            -fx-background-radius: 10px;                                            -fx-cursor: hand;"
                                    text="Load Product"/>

                            <TextField fx:id="productNameField" prefHeight="35.0" prefWidth="458.0"
                                       promptText="Product Name"
                                       style="-fx-background-color: rgba(255,255,255,0.12);                                            -fx-text-fill: #FFFFFF;                                            -fx-prompt-text-fill: #AAB7C8;                                            -fx-background-radius: 10px;                                            -fx-border-color: rgba(255,255,255,0.25);                                            -fx-border-radius: 10px;"/>

                            <TextField fx:id="productPriceField" prefHeight="35.0" promptText="Price"
                                       style="-fx-background-color: rgba(255,255,255,0.12);                                            -fx-text-fill: #FFFFFF;                                            -fx-prompt-text-fill: #AAB7C8;                                            -fx-background-radius: 10px;                                            -fx-border-color: rgba(255,255,255,0.25);                                            -fx-border-radius: 10px;"/>

                            <TextField fx:id="productStatusField" prefHeight="35.0" promptText="Status"
                                       style="-fx-background-color: rgba(255,255,255,0.12);                                            -fx-text-fill: #FFFFFF;                                            -fx-prompt-text-fill: #AAB7C8;                                            -fx-background-radius: 10px;                                            -fx-border-color: rgba(255,255,255,0.25);                                            -fx-border-radius: 10px;"/>

                            <TextField fx:id="productInventoryField" prefHeight="35.0" promptText="Inventory"
                                       style="-fx-background-color: rgba(255,255,255,0.12);                                            -fx-text-fill: #FFFFFF;                                            -fx-prompt-text-fill: #AAB7C8;                                            -fx-background-radius: 10px;                                            -fx-border-color: rgba(255,255,255,0.25);                                            -fx-border-radius: 10px;"/>

                            <HBox alignment="CENTER" spacing="10.0">

                                <Button maxWidth="Infinity" onAction="#editProduct" prefHeight="45.0"
                                        style="-fx-background-color: #FFFFFF;                                                -fx-text-fill: #243B55;                                                -fx-font-weight: bold;                                                -fx-background-radius: 10px;                                                -fx-cursor: hand;"
                                        text="Edit Product" HBox.hgrow="ALWAYS"/>


                                <Button maxWidth="Infinity" onAction="#removeProduct" prefHeight="45.0"
                                        style="-fx-background-color: #8B2635;                                                -fx-text-fill: WHITE;                                                -fx-font-weight: bold;                                                -fx-background-radius: 10px;                                                -fx-cursor: hand;"
                                        text="Delete Product" HBox.hgrow="ALWAYS"/>

                            </HBox>

                        </VBox>

                        <Button graphicTextGap="2.0" onAction="#requests" prefHeight="48.0" prefWidth="300.0"
                                style="-fx-background-color: #FFFFFF;                                        -fx-text-fill: #243B55;                                        -fx-font-size: 16px;                                        -fx-font-weight: bold;                                        -fx-background-radius: 10px;                                        -fx-cursor: hand;"
                                text="Manage Requests"/>

                        <Button onAction="#logout" prefHeight="29.0" prefWidth="180.0"
                                style="-fx-background-color: transparent;                                        -fx-text-fill: #B8C6D9;                                        -fx-font-size: 14px;                                        -fx-cursor: hand;"
                                text="Logout"/>

                    </VBox>

                </content>

            </ScrollPane>

        </StackPane>

    </children>

</AnchorPane>
