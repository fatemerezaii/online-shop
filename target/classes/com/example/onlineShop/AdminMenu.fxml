<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="view.AdminMenuController"
            style="-fx-background-color: #243B55;">

    <children>

        <StackPane
                AnchorPane.topAnchor="0.0"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0">

            <ScrollPane
                    fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="NEVER"
                    style="-fx-background: transparent;
                           -fx-background-color: transparent;">

                <content>

                    <VBox
                            alignment="CENTER"
                            maxWidth="600.0"
                            spacing="18.0">

                        <padding>
                            <Insets top="30.0"
                                    right="30.0"
                                    bottom="30.0"
                                    left="30.0"/>
                        </padding>


                        <!-- ===================== -->
                        <!-- TITLE -->
                        <!-- ===================== -->

                        <Label
                                text="Admin Menu"
                                textFill="WHITE">

                            <font>
                                <Font
                                        name="System Bold"
                                        size="32.0"/>
                            </font>

                        </Label>


                        <Label
                                text="Manage your online shop"
                                textFill="#B8C6D9">

                            <font>
                                <Font
                                        name="System"
                                        size="15.0"/>
                            </font>

                        </Label>


                        <!-- ===================== -->
                        <!-- COMMAND SECTION -->
                        <!-- ===================== -->

                        <VBox
                                spacing="12.0"
                                maxWidth="500.0"
                                style="-fx-background-color: rgba(255,255,255,0.08);
                                       -fx-background-radius: 15px;
                                       -fx-padding: 20px;
                                       -fx-border-color: rgba(255,255,255,0.15);
                                       -fx-border-radius: 15px;">

                            <Label
                                    text="Admin Commands"
                                    textFill="WHITE">

                                <font>
                                    <Font
                                            name="System Bold"
                                            size="18.0"/>
                                </font>

                            </Label>


                            <TextField
                                    fx:id="commandField"
                                    onAction="#executeCommand"
                                    prefHeight="48.0"
                                    promptText="Enter command..."
                                    style="-fx-background-color: rgba(255,255,255,0.12);
                                           -fx-text-fill: #FFFFFF;
                                           -fx-prompt-text-fill: #AAB7C8;
                                           -fx-font-size: 14px;
                                           -fx-background-radius: 10px;
                                           -fx-border-color: rgba(255,255,255,0.25);
                                           -fx-border-radius: 10px;"/>


                            <Button
                                    onAction="#executeCommand"
                                    prefHeight="45.0"
                                    maxWidth="Infinity"
                                    text="Execute Command"
                                    style="-fx-background-color: #FFFFFF;
                                           -fx-text-fill: #243B55;
                                           -fx-font-size: 15px;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 10px;
                                           -fx-cursor: hand;"/>


                            <TextArea
                                    fx:id="outputArea"
                                    editable="false"
                                    focusTraversable="false"
                                    prefHeight="120.0"
                                    wrapText="true"
                                    promptText="Command result..."
                                    style="-fx-control-inner-background: rgba(255,255,255,0.10);
                                           -fx-text-fill: #243B55;
                                           -fx-prompt-text-fill: #AAB7C8;
                                           -fx-background-radius: 10px;
                                           -fx-border-color: rgba(255,255,255,0.20);
                                           -fx-border-radius: 10px;"/>

                        </VBox>


                        <!-- ===================== -->
                        <!-- PRODUCT MANAGEMENT -->
                        <!-- ===================== -->

                        <VBox
                                spacing="12.0"
                                maxWidth="500.0"
                                style="-fx-background-color: rgba(255,255,255,0.08);
                                       -fx-background-radius: 15px;
                                       -fx-padding: 20px;
                                       -fx-border-color: rgba(255,255,255,0.15);
                                       -fx-border-radius: 15px;">

                            <Label
                                    text="Product Management"
                                    textFill="WHITE">

                                <font>
                                    <Font
                                            name="System Bold"
                                            size="18.0"/>
                                </font>

                            </Label>


                            <!-- PRODUCT ID -->

                            <TextField
                                    fx:id="productIdField"
                                    prefHeight="45.0"
                                    promptText="Product ID"
                                    style="-fx-background-color: rgba(255,255,255,0.12);
                                           -fx-text-fill: #FFFFFF;
                                           -fx-prompt-text-fill: #AAB7C8;
                                           -fx-background-radius: 10px;
                                           -fx-border-color: rgba(255,255,255,0.25);
                                           -fx-border-radius: 10px;"/>


                            <!-- LOAD PRODUCT -->

                            <Button
                                    onAction="#loadProduct"
                                    prefHeight="42.0"
                                    maxWidth="Infinity"
                                    text="Load Product"
                                    style="-fx-background-color: #FFFFFF;
                                           -fx-text-fill: #243B55;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 10px;
                                           -fx-cursor: hand;"/>


                            <!-- PRODUCT NAME -->

                            <TextField
                                    fx:id="productNameField"
                                    prefHeight="45.0"
                                    promptText="Product Name"
                                    style="-fx-background-color: rgba(255,255,255,0.12);
                                           -fx-text-fill: #FFFFFF;
                                           -fx-prompt-text-fill: #AAB7C8;
                                           -fx-background-radius: 10px;
                                           -fx-border-color: rgba(255,255,255,0.25);
                                           -fx-border-radius: 10px;"/>


                            <!-- PRODUCT PRICE -->

                            <TextField
                                    fx:id="productPriceField"
                                    prefHeight="45.0"
                                    promptText="Price"
                                    style="-fx-background-color: rgba(255,255,255,0.12);
                                           -fx-text-fill: #FFFFFF;
                                           -fx-prompt-text-fill: #AAB7C8;
                                           -fx-background-radius: 10px;
                                           -fx-border-color: rgba(255,255,255,0.25);
                                           -fx-border-radius: 10px;"/>


                            <!-- PRODUCT STATUS -->

                            <TextField
                                    fx:id="productStatusField"
                                    prefHeight="45.0"
                                    promptText="Status"
                                    style="-fx-background-color: rgba(255,255,255,0.12);
                                           -fx-text-fill: #FFFFFF;
                                           -fx-prompt-text-fill: #AAB7C8;
                                           -fx-background-radius: 10px;
                                           -fx-border-color: rgba(255,255,255,0.25);
                                           -fx-border-radius: 10px;"/>


                            <!-- PRODUCT INVENTORY -->

                            <TextField
                                    fx:id="productInventoryField"
                                    prefHeight="45.0"
                                    promptText="Inventory"
                                    style="-fx-background-color: rgba(255,255,255,0.12);
                                           -fx-text-fill: #FFFFFF;
                                           -fx-prompt-text-fill: #AAB7C8;
                                           -fx-background-radius: 10px;
                                           -fx-border-color: rgba(255,255,255,0.25);
                                           -fx-border-radius: 10px;"/>


                            <!-- EDIT / DELETE -->

                            <HBox
                                    spacing="10.0"
                                    alignment="CENTER">

                                <Button
                                        onAction="#editProduct"
                                        prefHeight="45.0"
                                        maxWidth="Infinity"
                                        HBox.hgrow="ALWAYS"
                                        text="Edit Product"
                                        style="-fx-background-color: #FFFFFF;
                                               -fx-text-fill: #243B55;
                                               -fx-font-weight: bold;
                                               -fx-background-radius: 10px;
                                               -fx-cursor: hand;"/>


                                <Button
                                        onAction="#removeProduct"
                                        prefHeight="45.0"
                                        maxWidth="Infinity"
                                        HBox.hgrow="ALWAYS"
                                        text="Delete Product"
                                        style="-fx-background-color: #8B2635;
                                               -fx-text-fill: WHITE;
                                               -fx-font-weight: bold;
                                               -fx-background-radius: 10px;
                                               -fx-cursor: hand;"/>

                            </HBox>

                        </VBox>


                        <!-- ===================== -->
                        <!-- REQUEST MANAGEMENT -->
                        <!-- ===================== -->

                        <Button
                                onAction="#requests"
                                prefHeight="48.0"
                                prefWidth="300.0"
                                text="Manage Requests"
                                style="-fx-background-color: #FFFFFF;
                                       -fx-text-fill: #243B55;
                                       -fx-font-size: 16px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 10px;
                                       -fx-cursor: hand;"/>


                        <!-- ===================== -->
                        <!-- LOGOUT -->
                        <!-- ===================== -->

                        <Button
                                onAction="#logout"
                                prefHeight="42.0"
                                prefWidth="180.0"
                                text="Logout"
                                style="-fx-background-color: transparent;
                                       -fx-text-fill: #B8C6D9;
                                       -fx-font-size: 14px;
                                       -fx-cursor: hand;"/>

                    </VBox>

                </content>

            </ScrollPane>

        </StackPane>

    </children>

</AnchorPane>