<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.control.ListView?>
        <?import javafx.scene.layout.AnchorPane?>
        <?import javafx.scene.layout.HBox?>
        <?import javafx.scene.layout.StackPane?>
        <?import javafx.scene.layout.VBox?>
        <?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="view.HistoryController"
            style="-fx-background-color: #17212F;">

    <children>

        <StackPane
                AnchorPane.topAnchor="0.0"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0">

            <VBox
                    spacing="18.0"
                    maxWidth="850.0"
                    maxHeight="550.0">

                <VBox spacing="5.0">

                    <Label
                            text="Purchase History"
                            textFill="WHITE">

                        <font>
                            <Font
                                    name="System Bold"
                                    size="30.0"/>
                        </font>

                    </Label>

                    <Label
                            text="View your invoices and purchase history"
                            textFill="#B8C6D9">

                        <font>
                            <Font
                                    name="System"
                                    size="14.0"/>
                        </font>

                    </Label>

                </VBox>

                <HBox
                        spacing="45.0"
                        style="-fx-background-color: rgba(255,255,255,0.06);
                               -fx-background-radius: 12px;
                               -fx-padding: 18px;">

                    <VBox spacing="4.0">

                        <Label
                                text="Invoice ID"
                                textFill="#8FA3BA"/>

                        <Label
                                fx:id="factorIdLabel"
                                text="-"
                                textFill="WHITE">

                            <font>
                                <Font
                                        name="System Bold"
                                        size="15.0"/>
                            </font>

                        </Label>

                    </VBox>

                    <VBox spacing="4.0">

                        <Label
                                text="Date"
                                textFill="#8FA3BA"/>

                        <Label
                                fx:id="dateLabel"
                                text="-"
                                textFill="WHITE">

                            <font>
                                <Font
                                        name="System Bold"
                                        size="15.0"/>
                            </font>

                        </Label>

                    </VBox>

                    <VBox spacing="4.0">

                        <Label
                                text="Paid Price"
                                textFill="#8FA3BA"/>

                        <Label
                                fx:id="paidPriceLabel"
                                text="-"
                                textFill="WHITE">

                            <font>
                                <Font
                                        name="System Bold"
                                        size="15.0"/>
                            </font>

                        </Label>

                    </VBox>

                </HBox>

                <VBox
                        spacing="10.0"
                        VBox.vgrow="ALWAYS">

                    <Label
                            text="Invoices"
                            textFill="WHITE">

                        <font>
                            <Font
                                    name="System Bold"
                                    size="17.0"/>
                        </font>

                    </Label>


                    <ListView
                            fx:id="invoiceListView"
                            VBox.vgrow="ALWAYS"
                            style="-fx-background-color: white;
                                   -fx-control-inner-background: white;
                                   -fx-background-radius: 10px;
                                   -fx-border-color: rgba(255,255,255,0.2);
                                   -fx-border-radius: 10px;"/>

                </VBox>

                <Button
                        fx:id="backButton"
                        text="Back"
                        mnemonicParsing="false"
                        onAction="#back"
                        prefWidth="100.0"
                        prefHeight="40.0"
                        style="-fx-background-color: rgba(255,255,255,0.12);
                               -fx-text-fill: WHITE;
                               -fx-font-size: 14px;
                               -fx-background-radius: 10px;
                               -fx-border-color: rgba(255,255,255,0.25);
                               -fx-border-radius: 10px;
                               -fx-cursor: hand;"/>

            </VBox>

        </StackPane>

    </children>

</AnchorPane>