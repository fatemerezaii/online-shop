<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="view.MainPageController"
            style="-fx-background-color: linear-gradient(to bottom right, #141E30, #243B55);">

    <children>

        <VBox alignment="CENTER"
              spacing="22.0"
              prefWidth="800.0"
              prefHeight="500.0"
              AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">
            <Label text="Main Page"
                   textFill="WHITE">
                <font>
                    <Font name="System Bold" size="36.0"/>
                </font>
            </Label>

            <Label text="Welcome to Online Shop"
                   textFill="#B8C6D9">
                <font>
                    <Font name="System" size="16.0"/>
                </font>
            </Label>

            <VBox alignment="CENTER"
                  spacing="14.0"
                  maxWidth="260.0">

                <Button fx:id="loginBtn"
                        mnemonicParsing="false"
                        onAction="#login"
                        text="Login"
                        prefWidth="260.0"
                        prefHeight="48.0"
                        style="-fx-background-color: #FFFFFF;
                               -fx-text-fill: #243B55;
                               -fx-font-size: 16px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10px;
                               -fx-cursor: hand;"/>

                <Button fx:id="signUpBtn"
                        mnemonicParsing="false"
                        onAction="#signUp"
                        text="Sign Up"
                        prefWidth="260.0"
                        prefHeight="48.0"
                        style="-fx-background-color: transparent;
                               -fx-border-color: #FFFFFF;
                               -fx-border-width: 1.5px;
                               -fx-border-radius: 10px;
                               -fx-text-fill: #FFFFFF;
                               -fx-font-size: 16px;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;"/>

                <Button fx:id="productsBtn"
                        mnemonicParsing="false"
                        onAction="#products"
                        text="Products"
                        prefWidth="260.0"
                        prefHeight="48.0"
                        style="-fx-background-color: rgba(255,255,255,0.12);
                               -fx-text-fill: #FFFFFF;
                               -fx-font-size: 16px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10px;
                               -fx-cursor: hand;"/>

            </VBox>

        </VBox>

    </children>
</AnchorPane>
