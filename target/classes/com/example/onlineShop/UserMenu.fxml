<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" style="-fx-background-color: linear-gradient(to bottom right, #243B55, #141E30);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.UserMenuController">

    <children>

        <VBox alignment="CENTER" prefHeight="500.0" prefWidth="800.0" spacing="25.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <Label text="User Menu" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="36.0" />
                </font>
            </Label>

            <Label text="Welcome back" textFill="#B8C6D9">
                <font>
                    <Font name="System" size="16.0" />
                </font>
            </Label>

            <VBox alignment="CENTER" maxWidth="280.0" spacing="14.0">

                <Button fx:id="profileBtn" mnemonicParsing="false" onAction="#profile" prefHeight="48.0" prefWidth="280.0" style="-fx-background-color: #FFFFFF;                                -fx-text-fill: #243B55;                                -fx-font-size: 16px;                                -fx-font-weight: bold;                                -fx-background-radius: 10px;                                -fx-cursor: hand;" text="Profile" />

                <Button fx:id="productsBtn" mnemonicParsing="false" onAction="#products" prefHeight="48.0" prefWidth="280.0" style="-fx-background-color: rgba(255,255,255,0.12);                                -fx-text-fill: #FFFFFF;                                -fx-font-size: 16px;                                -fx-font-weight: bold;                                -fx-background-radius: 10px;                                -fx-border-color: rgba(255,255,255,0.25);                                -fx-border-width: 1px;                                -fx-border-radius: 10px;                                -fx-cursor: hand;" text="Products" />

                <Button fx:id="creditBtn" mnemonicParsing="false" onAction="#credit" prefHeight="48.0" prefWidth="280.0" style="-fx-background-color: rgba(255,255,255,0.12);                                -fx-text-fill: #FFFFFF;                                -fx-font-size: 16px;                                -fx-font-weight: bold;                                -fx-background-radius: 10px;                                -fx-border-color: rgba(255,255,255,0.25);                                -fx-border-width: 1px;                                -fx-border-radius: 10px;                                -fx-cursor: hand;" text="Charge Credit" />

                <Button fx:id="historyBtn" mnemonicParsing="false" onAction="#history" prefHeight="48.0" prefWidth="280.0" style="-fx-background-color: transparent;                                -fx-text-fill: #FFFFFF;                                -fx-font-size: 16px;                                -fx-font-weight: bold;                                -fx-border-color: #FFFFFF;                                -fx-border-width: 1.5px;                                -fx-border-radius: 10px;                                -fx-cursor: hand;" text="History" />

            </VBox>

        </VBox>
      <Button fx:id="backButton" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#back" prefHeight="48.0" prefWidth="74.0" style="-fx-background-color: transparent;                                -fx-text-fill: #FFFFFF;                                -fx-font-size: 16px;                                -fx-font-weight: bold;                                -fx-border-color: #FFFFFF;                                -fx-border-width: 1.5px;                                -fx-border-radius: 10px;                                -fx-cursor: hand;" text="Back" />

    </children>

</AnchorPane>
