<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.control.TextArea?>
        <?import javafx.scene.control.TextField?>
        <?import javafx.scene.layout.AnchorPane?>
        <?import javafx.scene.layout.HBox?>
        <?import javafx.scene.layout.StackPane?>
        <?import javafx.scene.layout.VBox?>
        <?import javafx.scene.text.Font?>

<AnchorPane
        prefHeight="700.0"
        prefWidth="650.0"
        style="-fx-background-color: linear-gradient(to bottom right, #141E30, #243B55);"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="view.ProductDetailsViewController">

    <children>

        <StackPane
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0"
                AnchorPane.topAnchor="0.0">

            <VBox
                    alignment="CENTER"
                    maxWidth="500.0"
                    spacing="15.0">

                <Label
                        text="Product Details"
                        textFill="WHITE">

                    <font>
                        <Font
                                name="System Bold"
                                size="32.0"/>
                    </font>

                </Label>


                <Label
                        fx:id="nameLabel"
                        text="Product Name"
                        textFill="#B8C6D9">

                    <font>
                        <Font
                                name="System Bold"
                                size="22.0"/>
                    </font>

                </Label>


                <VBox
                        alignment="CENTER"
                        maxWidth="420.0"
                        spacing="10.0"
                        style="-fx-background-color: rgba(255,255,255,0.10);
                               -fx-background-radius: 15px;
                               -fx-border-color: rgba(255,255,255,0.20);
                               -fx-border-radius: 15px;
                               -fx-border-width: 1px;
                               -fx-padding: 18px;">

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="10.0">

                        <Label
                                text="Price:"
                                textFill="#B8C6D9"/>

                        <Label
                                fx:id="priceLabel"
                                text="0.0"
                                textFill="WHITE"/>

                    </HBox>


                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="10.0">

                        <Label
                                text="Status:"
                                textFill="#B8C6D9"/>

                        <Label
                                fx:id="statusLabel"
                                text="Available"
                                textFill="WHITE"/>

                    </HBox>


                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="10.0">

                        <Label
                                text="Category:"
                                textFill="#B8C6D9"/>

                        <Label
                                fx:id="categoryLabel"
                                text="Category"
                                textFill="WHITE"/>

                    </HBox>


                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="10.0">

                        <Label
                                text="Rating:"
                                textFill="#B8C6D9"/>

                        <Label
                                fx:id="ratingLabel"
                                text="0.0"
                                textFill="WHITE"/>

                    </HBox>
                    <Label
                            text="Additional Information"
                            textFill="#B8C6D9"
                            style="-fx-font-weight: bold;"/>

                    <Label
                            fx:id="detailsLabel"
                            text="Details"
                            textFill="WHITE"
                            wrapText="true"/>

                </VBox>

                <Button
                        fx:id="addToCartButton"
                        mnemonicParsing="false"
                        onAction="#addToCart"
                        prefHeight="45.0"
                        prefWidth="420.0"
                        text="Add to Cart"
                        style="-fx-background-color: #FFFFFF;
                               -fx-text-fill: #243B55;
                               -fx-font-size: 15px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10px;
                               -fx-cursor: hand;"/>

                <HBox
                        alignment="CENTER"
                        spacing="10.0">

                    <TextField
                            fx:id="ratingField"
                            prefHeight="42.0"
                            prefWidth="280.0"
                            promptText="Enter rating (0 - 5)"
                            style="-fx-background-color: rgba(255,255,255,0.12);
                                   -fx-text-fill: #FFFFFF;
                                   -fx-prompt-text-fill: #AAB7C8;
                                   -fx-background-radius: 10px;
                                   -fx-border-color: rgba(255,255,255,0.25);
                                   -fx-border-radius: 10px;"/>

                    <Button
                            fx:id="rateButton"
                            mnemonicParsing="false"
                            onAction="#rateProduct"
                            prefHeight="42.0"
                            prefWidth="120.0"
                            text="Rate"
                            style="-fx-background-color: #FFFFFF;
                                   -fx-text-fill: #243B55;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 10px;
                                   -fx-cursor: hand;"/>

                </HBox>

                <TextArea
                        fx:id="commentArea"
                        prefHeight="75.0"
                        prefWidth="420.0"
                        promptText="Write your comment..."
                        wrapText="true"
                        style="-fx-background-color: rgba(255,255,255,0.12);
                               -fx-text-fill: #FFFFFF;
                               -fx-prompt-text-fill: #AAB7C8;
                               -fx-background-radius: 10px;
                               -fx-border-color: rgba(255,255,255,0.25);
                               -fx-border-radius: 10px;"/>


                <Button
                        fx:id="commentButton"
                        mnemonicParsing="false"
                        onAction="#addComment"
                        prefHeight="45.0"
                        prefWidth="420.0"
                        text="Add Comment"
                        style="-fx-background-color: #FFFFFF;
                               -fx-text-fill: #243B55;
                               -fx-font-size: 15px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10px;
                               -fx-cursor: hand;"/>

                <Button
                        mnemonicParsing="false"
                        onAction="#back"
                        prefHeight="45.0"
                        prefWidth="420.0"
                        text="Back"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #B8C6D9;
                               -fx-border-color: #B8C6D9;
                               -fx-border-radius: 10px;
                               -fx-background-radius: 10px;
                               -fx-cursor: hand;"/>

            </VBox>

        </StackPane>

    </children>

</AnchorPane>