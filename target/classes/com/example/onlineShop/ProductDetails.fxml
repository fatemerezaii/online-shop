<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.layout.AnchorPane?>
        <?import javafx.scene.layout.HBox?>
        <?import javafx.scene.layout.StackPane?>
        <?import javafx.scene.layout.VBox?>
        <?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="600.0"
            style="-fx-background-color: linear-gradient(to bottom right, #141E30, #243B55);"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="view.ProductDetailsController">

    <children>

        <StackPane AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0"
                   AnchorPane.topAnchor="0.0">

            <VBox alignment="CENTER"
                  maxWidth="400.0"
                  spacing="18.0">

                <Label text="Product Details"
                       textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="32.0"/>
                    </font>
                </Label>

                <Label fx:id="nameLabel"
                       text="Product Name"
                       textFill="#B8C6D9">
                    <font>
                        <Font name="System Bold" size="20.0"/>
                    </font>
                </Label>

                <VBox alignment="CENTER"
                      maxWidth="320.0"
                      spacing="12.0"
                      style="-fx-background-color: rgba(255,255,255,0.10);
                             -fx-background-radius: 15px;
                             -fx-border-color: rgba(255,255,255,0.20);
                             -fx-border-radius: 15px;
                             -fx-border-width: 1px;
                             -fx-padding: 20px;">

                    <HBox alignment="CENTER_LEFT"
                          spacing="10.0">
                        <Label text="Price:"
                               textFill="#B8C6D9">
                            <font>
                                <Font name="System Bold" size="15.0"/>
                            </font>
                        </Label>

                        <Label fx:id="priceLabel"
                               text="0.0"
                               textFill="WHITE">
                            <font>
                                <Font name="System" size="15.0"/>
                            </font>
                        </Label>
                    </HBox>

                    <HBox alignment="CENTER_LEFT"
                          spacing="10.0">
                        <Label text="Status:"
                               textFill="#B8C6D9">
                            <font>
                                <Font name="System Bold" size="15.0"/>
                            </font>
                        </Label>

                        <Label fx:id="statusLabel"
                               text="Available"
                               textFill="WHITE">
                            <font>
                                <Font name="System" size="15.0"/>
                            </font>
                        </Label>
                    </HBox>

                    <HBox alignment="CENTER_LEFT"
                          spacing="10.0">
                        <Label text="Rating:"
                               textFill="#B8C6D9">
                            <font>
                                <Font name="System Bold" size="15.0"/>
                            </font>
                        </Label>

                        <Label fx:id="ratingLabel"
                               text="0.0"
                               textFill="WHITE">
                            <font>
                                <Font name="System" size="15.0"/>
                            </font>
                        </Label>
                    </HBox>

                </VBox>

                <Button mnemonicParsing="false"
                        onAction="#back"
                        prefHeight="48.0"
                        prefWidth="320.0"
                        style="-fx-background-color: #FFFFFF;
                               -fx-text-fill: #243B55;
                               -fx-font-size: 16px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10px;
                               -fx-cursor: hand;"
                        text="Back"/>

            </VBox>

        </StackPane>

    </children>

</AnchorPane>