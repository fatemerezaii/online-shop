<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane
        prefHeight="600.0"
        prefWidth="600.0"
        style="-fx-background-color: linear-gradient(to bottom right, #141E30, #243B55);"
        xmlns="http://javafx.com/javafx/23.0.1"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="view.ChargeCreditController">

    <children>

        <StackPane
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0"
                AnchorPane.topAnchor="0.0">

            <VBox
                    alignment="CENTER"
                    maxWidth="360.0"
                    spacing="15.0">

                <Label
                        text="Increase Credit"
                        textFill="WHITE">

                    <font>
                        <Font
                                name="System Bold"
                                size="30.0"/>
                    </font>

                </Label>

                <Label
                        text="Enter your payment information"
                        textFill="#B8C6D9">

                    <font>
                        <Font
                                name="System"
                                size="14.0"/>
                    </font>

                </Label>

                <VBox
                        alignment="CENTER"
                        maxWidth="300.0"
                        spacing="10.0">

                    <TextField
                            fx:id="cardNumberField"
                            prefHeight="45.0"
                            prefWidth="300.0"
                            promptText="Card Number (16 digits)"
                            style="-fx-background-color: rgba(255,255,255,0.12);
                                   -fx-text-fill: #FFFFFF;
                                   -fx-prompt-text-fill: #AAB7C8;
                                   -fx-font-size: 14px;
                                   -fx-background-radius: 10px;
                                   -fx-border-color: rgba(255,255,255,0.25);
                                   -fx-border-radius: 10px;
                                   -fx-border-width: 1px;"/>

                    <PasswordField
                            fx:id="cardPasswordField"
                            prefHeight="45.0"
                            prefWidth="300.0"
                            promptText="Card Password (4 digits)"
                            style="-fx-background-color: rgba(255,255,255,0.12);
                                   -fx-text-fill: #FFFFFF;
                                   -fx-prompt-text-fill: #AAB7C8;
                                   -fx-font-size: 14px;
                                   -fx-background-radius: 10px;
                                   -fx-border-color: rgba(255,255,255,0.25);
                                   -fx-border-radius: 10px;
                                   -fx-border-width: 1px;"/>

                    <TextField
                            fx:id="cvv2Field"
                            prefHeight="45.0"
                            prefWidth="300.0"
                            promptText="CVV2 (3 or 4 digits)"
                            style="-fx-background-color: rgba(255,255,255,0.12);
                                   -fx-text-fill: #FFFFFF;
                                   -fx-prompt-text-fill: #AAB7C8;
                                   -fx-font-size: 14px;
                                   -fx-background-radius: 10px;
                                   -fx-border-color: rgba(255,255,255,0.25);
                                   -fx-border-radius: 10px;
                                   -fx-border-width: 1px;"/>

                    <TextField
                            fx:id="amountField"
                            prefHeight="45.0"
                            prefWidth="300.0"
                            promptText="Amount"
                            style="-fx-background-color: rgba(255,255,255,0.12);
                                   -fx-text-fill: #FFFFFF;
                                   -fx-prompt-text-fill: #AAB7C8;
                                   -fx-font-size: 14px;
                                   -fx-background-radius: 10px;
                                   -fx-border-color: rgba(255,255,255,0.25);
                                   -fx-border-radius: 10px;
                                   -fx-border-width: 1px;"/>

                    <Button
                            fx:id="increaseCreditButton"
                            mnemonicParsing="false"
                            onAction="#increaseCredit"
                            prefHeight="48.0"
                            prefWidth="300.0"
                            style="-fx-background-color: #FFFFFF;
                                   -fx-text-fill: #243B55;
                                   -fx-font-size: 16px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 10px;
                                   -fx-cursor: hand;"
                            text="Send Request"/>

                    <Button
                            mnemonicParsing="false"
                            onAction="#back"
                            prefHeight="45.0"
                            prefWidth="300.0"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #B8C6D9;
                                   -fx-font-size: 14px;
                                   -fx-cursor: hand;"
                            text="Back"/>

                </VBox>

            </VBox>

        </StackPane>

    </children>

</AnchorPane>